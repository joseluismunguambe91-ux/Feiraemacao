[Unit]
Description=Fila do FeiraemAcao (relatórios, notificações por email)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/feiraemacao
ExecStart=/usr/bin/php /var/www/feiraemacao/artisan queue:work --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
