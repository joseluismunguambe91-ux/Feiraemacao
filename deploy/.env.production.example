# Copiar para .env no servidor (dentro de /var/www/feiraemacao) e preencher
# os valores com REAL_ (nunca commitar o .env real no Git).
# Depois de criar: php artisan key:generate --force

APP_NAME="FeiraEmAcao"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://139.59.137.26

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=feiraemacao
DB_USERNAME=feiraemacao
DB_PASSWORD=TROCAR_POR_UMA_SENHA_FORTE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Trocar por um driver real assim que tiver credenciais de email
# (ex.: smtp da Zoho/Gmail/SendGrid) — sem isto, InscricaoAvaliada só
# grava no log, o professor/aluno não recebe o email.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="naoresponder@feiraemacao.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
